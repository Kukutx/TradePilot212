{
  "name": "tradepilot212",
  "version": "2.92.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Trading 212 MCP app for ChatGPT with portfolio dashboards, flexible order sizing, OAuth/PKCE, Demo/Live separation, and human-confirmed execution.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/deploy-selfhost.mjs",
    "dev": "pnpm build:widget && tsx watch src/adapters/node/index.ts",
    "dev:chatgpt": "node scripts/dev-chatgpt.mjs",
    "start": "node dist/node/adapters/node/index.js",
    "stdio": "tsx src/adapters/stdio/index.ts",
    "preview": "pnpm build:widget && tsx src/adapters/preview/index.ts",
    "dev:cloudflare": "pnpm build:widget && wrangler dev",
    "deploy:cloudflare": "pnpm build:widget && wrangler deploy",
    "build:widget": "vite build",
    "build": "pnpm build:widget && pnpm build:node",
    "typecheck": "pnpm cf:types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "check:api": "vitest run src/core/api-spec.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "audit:ui": "pnpm build:widget && node scripts/ui-audit.mjs",
    "cf:types": "wrangler types",
    "build:node": "tsc -p tsconfig.node.json",
    "build:plugin": "pnpm build:prompts && pnpm build:widget && node scripts/build-plugin.mjs",
    "build:prompts": "tsx scripts/build-prompts.ts",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kukutx/TradePilot212.git"
  },
  "homepage": "https://github.com/Kukutx/TradePilot212#readme",
  "bugs": {
    "url": "https://github.com/Kukutx/TradePilot212/issues"
  },
  "keywords": [
    "trading212",
    "mcp",
    "chatgpt",
    "chatgpt-app",
    "self-hosted",
    "cloudflare-workers",
    "typescript",
    "react",
    "hono"
  ]
}
