{
  "name": "tradepilot212",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, multi-host MCP App for Trading 212 with safe automation, OAuth/PKCE, Demo/Live isolation, and human-approved execution.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/deploy-selfhost.mjs",
    "dev": "pnpm build:widget && tsx watch src/adapters/node/index.ts",
    "dev:chatgpt": "node scripts/dev-chatgpt.mjs",
    "start": "node dist/node/adapters/node/index.js",
    "dev:cloudflare": "pnpm build:widget && wrangler dev",
    "deploy:cloudflare": "pnpm build:widget && wrangler deploy",
    "build:widget": "vite build",
    "build": "pnpm build:widget && pnpm build:node",
    "typecheck": "pnpm cf:types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "cf:types": "wrangler types",
    "build:node": "tsc -p tsconfig.node.json",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "dotenv": "^18.0.5",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kukutx/TradePilot212.git"
  },
  "homepage": "https://github.com/Kukutx/TradePilot212#readme",
  "bugs": {
    "url": "https://github.com/Kukutx/TradePilot212/issues"
  },
  "keywords": [
    "trading212",
    "mcp",
    "chatgpt",
    "chatgpt-app",
    "self-hosted",
    "cloudflare-workers",
    "typescript",
    "react",
    "hono"
  ]
}
