{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/node",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/app/**/*.ts",
    "src/adapters/node/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "src/adapters/cloudflare/**",
    "src/ui/**"
  ]
}
