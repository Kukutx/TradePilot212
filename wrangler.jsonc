{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradepilot212",
  "main": "src/adapters/cloudflare/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/widget", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "TRADEPILOT_STATE", "class_name": "TradePilotState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TradePilotState"] }],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } }
}
