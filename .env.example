# Server
PORT=8000
# For hosted use: https://tradepilot.example.com
# dev:chatgpt fills this automatically from the Cloudflare quick tunnel.
PUBLIC_BASE_URL=http://localhost:8000

# Personal OAuth login protecting the ChatGPT MCP connection.
# Use long random values in production.
APP_LOGIN_PASSWORD=change-this-password
AUTH_SIGNING_SECRET=change-this-to-at-least-32-random-characters

# Trading 212 Demo credentials
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=

# Trading 212 Live credentials
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=
# Optional: another address for Trading 212's API (a proxy you run, or a test double), HTTPS only.
# The API keys are sent to it; redirects are never followed. Empty uses https://demo.trading212.com/api/v0 and https://live.trading212.com/api/v0.
T212_DEMO_BASE_URL=
T212_LIVE_BASE_URL=

# The IANA time zone days are counted in (Europe/London, America/New_York): the day the daily order
# limits reset, DIGEST_HOUR and the tax year's days. Empty is UTC (the widget's tax year then uses your own zone).
TIMEZONE=
# The tax year's first day as MM-DD, the default for the tax year summary: 01-01, or 04-06 for the UK.
TAX_YEAR_START=

# Default environment used when the user does not explicitly say Demo or Live.
# Keep demo for the safest out-of-box behavior; advanced personal setups may choose live.
DEFAULT_TRADING_ENV=demo

# Optional app-level safety caps. Set either cap to 0 to disable that specific app-level cap.
# Trading 212 broker/account limits still apply.
MAX_ORDER_NOTIONAL=5000
MAX_ORDER_QUANTITY=100000
CONFIRMATION_TTL_SECONDS=90

# Trading policy (docs/AUTOMATION.md). Binds Live by default; POLICY_APPLY_TO=live|demo|both|none.
POLICY_APPLY_TO=live
POLICY_MAX_POSITION_WEIGHT=0.25
POLICY_DAILY_ORDER_LIMIT=20
POLICY_DAILY_NOTIONAL_LIMIT=0
POLICY_ALLOWED_TICKERS=
POLICY_BLOCKED_TICKERS=
POLICY_ALLOWED_TYPES=
POLICY_MARKET_ORDERS_WHEN_CLOSED=false
POLICY_MAX_REFERENCE_AGE_SECONDS=0

# Let due Demo plans marked autoExecute run without confirmation. Live plans never do.
AUTOMATION_DEMO_ENABLED=false

# After one half of a stop-loss / take-profit pair fills, cancel the other (default true).
PROTECTIVE_OCO=true

# Report how each open order ends (filled, partly filled, cancelled, rejected) in the activity feed
# and, for fills, to the webhook. Reads only; checked about every 5 minutes (default true).
ORDER_WATCH=true

# Optional notifications: one or more HTTPS endpoints, separated by spaces, that receive due plans,
# fills, price alerts and unclear results, each laid out for its service (Slack, Discord, Telegram
# https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat>, ntfy, Bark, or plain JSON; put
# "ntfy:" and so on before a self-hosted one). NOTIFY_LOCALE=zh-CN writes them in Chinese.
# NOTIFY_QUIET_HOURS=22-07 holds all but urgent events in those hours (in TIMEZONE) and sends them
# as one message after. NOTIFY_WEBHOOK_SECRET adds an X-TradePilot-Signature HMAC header;
# NOTIFY_EVENTS limits the activity types (comma separated).
NOTIFY_WEBHOOK_URL=
NOTIFY_LOCALE=
NOTIFY_QUIET_HOURS=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_EVENTS=
# Send a short daily account digest to the webhook at this hour (0-23) in TIMEZONE, or at
# DIGEST_HOUR_UTC in UTC (set one, not both). Empty turns it off.
DIGEST_HOUR=
DIGEST_HOUR_UTC=

# Quotes for instruments you do not hold (Trading 212 has no quote endpoint). Used by get_quote,
# price alerts, plan legs and rebalance targets. stooq (default) is free, needs no key, and is
# unofficial and best effort. finnhub, twelvedata and alphavantage need a free QUOTE_API_KEY.
# US tickers map automatically; map others with QUOTE_SYMBOLS=VUSAl_EQ=VUSA.UK,SAPd_EQ=SAP.DE
# in the provider's symbol format and price unit. none turns external quotes off.
QUOTE_PROVIDER=stooq
QUOTE_API_KEY=
QUOTE_SYMBOLS=
# The fund the time-weighted return is compared with on the Performance tab: a Trading 212 ticker or a
# US symbol (default SPY, the S&P 500). Map non-US listings in QUOTE_SYMBOLS. none turns it off.
BENCHMARK=
# Trading 212's currency conversion fee, for the estimates of what a rebalance converts: 0.0015 (0.15%)
# by default, as on Invest and ISA accounts. Set 0 if you trade from balances in each currency.
FX_FEE_RATE=

# Optional: the only OAuth redirect hosts clients may register, comma separated, e.g.
# chatgpt.com,.claude.ai (a leading dot covers the domain and its subdomains). Empty allows any
# HTTPS host; loopback is always allowed.
OAUTH_REDIRECT_HOSTS=

# Try TradePilot without a Trading 212 key: a simulated EUR Demo account with holdings, history and
# pies. Market orders fill at once against the sample data. Live is off and nothing reaches Trading 212.
TRADEPILOT_SAMPLE_DATA=false
