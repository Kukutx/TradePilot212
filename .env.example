# V3 Personal: new configuration; no V2 env/API compatibility.
PUBLIC_ORIGIN=http://localhost:8080
PORT=8080
OWNER_PASSWORD=replace-with-24-plus-random-characters
JWT_SIGNING_SECRET=replace-with-48-plus-random-characters
OAUTH_CLIENT_ORIGINS=https://chatgpt.com
# sample is never used for real execution
DATA_SOURCE=sample
DEFAULT_ENVIRONMENT=demo
T212_DEMO_KEY=
T212_DEMO_SECRET=
T212_LIVE_KEY=
T212_LIVE_SECRET=
# Personal private execution is OFF by default and never for directory publishing.
PERSONAL_TRADING_ENABLED=false
PERSONAL_LIVE_TRADING_ENABLED=false
PERSONAL_APPROVAL_SECRET=replace-with-new-independent-32-plus-random-characters
PERSONAL_MAX_NOTIONAL=5000
PERSONAL_MAX_QUANTITY=100000
PERSONAL_CONFIRMATION_TTL=90
