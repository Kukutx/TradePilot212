# Server
PORT=8000
# For hosted use: https://tradepilot.example.com
# dev:chatgpt fills this automatically from the Cloudflare quick tunnel.
PUBLIC_BASE_URL=http://localhost:8000

# Personal OAuth login protecting the ChatGPT MCP connection.
# Use long random values in production.
APP_LOGIN_PASSWORD=change-this-password
AUTH_SIGNING_SECRET=change-this-to-at-least-32-random-characters

# Trading 212 Demo credentials
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=

# Trading 212 Live credentials
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=

# Default environment used when the user does not explicitly say Demo or Live.
# Keep demo for the safest out-of-box behavior; advanced personal setups may choose live.
DEFAULT_TRADING_ENV=demo

# Optional app-level safety caps. Set either cap to 0 to disable that specific app-level cap.
# Trading 212 broker/account limits still apply.
MAX_ORDER_NOTIONAL=5000
MAX_ORDER_QUANTITY=100000
CONFIRMATION_TTL_SECONDS=90
