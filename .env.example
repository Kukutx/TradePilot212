# Server
PORT=8000
# For hosted use: https://tradepilot.example.com
# dev:chatgpt fills this automatically from the Cloudflare quick tunnel.
PUBLIC_BASE_URL=http://localhost:8000

# Personal OAuth login protecting the ChatGPT MCP connection.
# Use long random values in production.
APP_LOGIN_PASSWORD=change-this-password
AUTH_SIGNING_SECRET=change-this-to-at-least-32-random-characters

# Trading 212 Demo credentials
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=

# Trading 212 Live credentials
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=

# Default environment used when the user does not explicitly say Demo or Live.
# Keep demo for the safest out-of-box behavior; advanced personal setups may choose live.
DEFAULT_TRADING_ENV=demo

# Optional app-level safety caps. Set either cap to 0 to disable that specific app-level cap.
# Trading 212 broker/account limits still apply.
MAX_ORDER_NOTIONAL=5000
MAX_ORDER_QUANTITY=100000
CONFIRMATION_TTL_SECONDS=90

# Trading policy (docs/AUTOMATION.md). Binds Live by default; POLICY_APPLY_TO=live|demo|both|none.
POLICY_APPLY_TO=live
POLICY_MAX_POSITION_WEIGHT=0.25
POLICY_DAILY_ORDER_LIMIT=20
POLICY_DAILY_NOTIONAL_LIMIT=0
POLICY_ALLOWED_TICKERS=
POLICY_BLOCKED_TICKERS=
POLICY_ALLOWED_TYPES=
POLICY_MARKET_ORDERS_WHEN_CLOSED=false
POLICY_MAX_REFERENCE_AGE_SECONDS=0

# Let due Demo plans marked autoExecute run without confirmation. Live plans never do.
AUTOMATION_DEMO_ENABLED=false

# After one half of a stop-loss / take-profit pair fills, cancel the other (default true).
PROTECTIVE_OCO=true

# Optional notifications: an HTTPS webhook (Slack, Discord, ntfy relay, your own endpoint) that
# receives due plans, fills, price alerts and unclear results. NOTIFY_WEBHOOK_SECRET adds an
# X-TradePilot-Signature HMAC header; NOTIFY_EVENTS limits the activity types (comma separated).
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_EVENTS=
# Send a short daily account digest to the webhook at this UTC hour (0-23). Empty turns it off.
DIGEST_HOUR_UTC=

# Quotes for instruments you do not hold (Trading 212 has no quote endpoint). Used by get_quote,
# price alerts, plan legs and rebalance targets. stooq (default) is free, needs no key, and is
# unofficial and best effort. finnhub, twelvedata and alphavantage need a free QUOTE_API_KEY.
# US tickers map automatically; map others with QUOTE_SYMBOLS=VUSAl_EQ=VUSA.UK,SAPd_EQ=SAP.DE
# in the provider's symbol format and price unit. none turns external quotes off.
QUOTE_PROVIDER=stooq
QUOTE_API_KEY=
QUOTE_SYMBOLS=

# Try TradePilot without a Trading 212 key: a simulated EUR Demo account with holdings, history and
# pies. Market orders fill at once against the sample data. Live is off and nothing reaches Trading 212.
TRADEPILOT_SAMPLE_DATA=false
